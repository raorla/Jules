{
  "name": "@jules/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@jules/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./egress-proxy": {
      "@jules/source": "./src/egress-proxy.ts",
      "types": "./dist/egress-proxy.d.ts",
      "default": "./dist/egress-proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dockerode": "5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
