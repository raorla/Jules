  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
