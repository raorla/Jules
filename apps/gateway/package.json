{
  "name": "@jules/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "@jules/source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=@jules/source src/main.ts"
  },
  "dependencies": {
    "@jules/config": "workspace:*",
    "@jules/db": "workspace:*",
    "@jules/forge": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
