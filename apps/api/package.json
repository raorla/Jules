{
  "name": "@jules/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "@jules/source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=@jules/source src/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.5",
    "@jules/audit": "workspace:*",
    "@jules/commands": "workspace:*",
    "@jules/config": "workspace:*",
    "@jules/db": "workspace:*",
    "@jules/metrics": "workspace:*",
    "@jules/security": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "libsodium-wrappers": "0.8.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/libsodium-wrappers": "0.8.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
