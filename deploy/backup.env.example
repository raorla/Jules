# Dépôt restic hors de l'hôte. Exemples :
#   RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/jules-backups
#   RESTIC_REPOSITORY=b2:jules-backups:/jules
#   RESTIC_REPOSITORY=sftp:backup@nas.example.org:/srv/jules
RESTIC_REPOSITORY=
# Identifiants du stockage (selon le backend choisi)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
