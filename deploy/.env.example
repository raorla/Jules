# Copier en deploy/.env. Les secrets ne vont pas ici : ils sont dans deploy/secrets/ (install.sh).
GITHUB_APP_ID=
JULES_MENTION=@jules
JULES_LANGUAGE=fr
# Groupe docker de l'hôte : `getent group docker | cut -d: -f3`
DOCKER_GID=
# runsc (gVisor) en production ; runc seulement pour un essai sans gVisor
JULES_SANDBOX_RUNTIME=runsc
# Registres joignables depuis les sandboxes (noms d'hôte, séparés par des virgules)
JULES_EGRESS_ALLOW=registry.npmjs.org
# Avec le profil caddy
JULES_DOMAIN=
# Avec le profil tunnel
CLOUDFLARE_TUNNEL_TOKEN=
